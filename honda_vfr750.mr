        .add_sample(5700 * units.rpm, 22.29 * units.deg)
        .add_sample(5800 * units.rpm, 22.77 * units.deg)
        .add_sample(5900 * units.rpm, 23.24 * units.deg)
        .add_sample(6000 * units.rpm, 23.72 * units.deg)
        .add_sample(6100 * units.rpm, 24.19 * units.deg)
