import "engine_sim.mr"

units units()
constants constants()
impulse_response_library ir_lib()

private node wires {
    output wire1: ignition_wire();
    output wire2: ignition_wire();
    output wire3: ignition_wire();
    output wire4: ignition_wire();
}

public node honda_vfr750 {
    alias output __out: engine;
    
    label bore(70.0 * units.mm)
    label stroke(48.6 * units.mm)
    label rod_length(101.5 * units.mm)
    label compression_height(17.3 * units.mm)

    engine engine(
        name: "Honda VFR750F (RC36-II)",
        starter_torque: 40 * units.lb_ft,
        starter_speed: 340 * units.rpm,
        redline: 10500 * units.rpm,
        fuel: fuel(
            max_burning_efficiency: 0.925,
            burning_efficiency_randomness: 0.1,
            molecular_afr: 14.1
        ),
        hf_gain: 0.012,
        noise: 0.8,
        jitter: 0.4,
        simulation_frequency: 20000
    )


    wires wires()

    crankshaft c0(
        throw: stroke / 2,
        flywheel_mass: 2.2 * units.kg,
        mass: 4.2 * units.kg,
        friction_torque: 10 * units.lb_ft,
        moment_of_inertia: 0.018, 
        position_x: 0.0,
        position_y: 0.0,
        tdc: 135 * units.deg
    )


    rod_journal rj0(angle: 0)            // pistons 1 and 2
    rod_journal rj1(angle: constants.pi) // pistons 3 and 4
    
    c0
        .add_rod_journal(rj1) 
        .add_rod_journal(rj0)
        

    piston_parameters piston_params(
        mass: (190 + 14.3 + 39) * units.g,
        compression_height: compression_height,
        wrist_pin_position: 0.0,
        displacement: 0
    )

    connecting_rod_parameters cr_params(
        mass: 311.0 * units.g,
        moment_of_inertia: 0.0015884918028487504,
        center_of_mass: 0.0,
        length: rod_length
    )

    cylinder_bank_parameters bank_params(
        bore: bore,
        deck_height: stroke / 2 + rod_length + compression_height
    )
    
    label idle_throttle_plate(0.9973)
    label carb_section_area(10.18) // cm2 for 36 mm keihin carbs
    intake intake(
        plenum_volume: 600 * units.cc, 
        plenum_cross_section_area: carb_section_area * 4 * units.cm2,
        intake_flow_rate: k_carb(150.0 * 4),
        idle_flow_rate: k_carb(0.01 * 4),
        idle_throttle_plate_position: idle_throttle_plate,
        throttle_gamma: 1.0
    )

   exhaust_system_parameters es_params(
        outlet_flow_rate: k_carb(1200.0),
        primary_tube_length: 0.75 * units.m,  
        primary_flow_rate: k_carb(380.0),     
        velocity_decay: 1.3,
        volume: 4.5 * units.L                
    )

    label impulse_response(ir_lib.mild_exhaust_0)
    exhaust_system exhaust(
        es_params,
        audio_volume: 1.0,
        impulse_response: impulse_response
    )


    cylinder_bank b0(bank_params, angle: 45 * units.deg)   // rear bank
    cylinder_bank b1(bank_params, angle: -45 * units.deg)  // front bank

    b0 
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.01)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj1,
            intake: intake,
            exhaust_system: exhaust,
            ignition_wire: wires.wire3
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.01)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj0,
            intake: intake,
            exhaust_system: exhaust,
            ignition_wire: wires.wire1
        )
        
    
    b1 
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.01)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj1,
            intake: intake,
            exhaust_system: exhaust,
            ignition_wire: wires.wire4
        )
        .add_cylinder(
            piston: piston(piston_params, blowby: k_28inH2O(0.01)),
            connecting_rod: connecting_rod(cr_params),
            rod_journal: rj0,
            intake: intake,
            exhaust_system: exhaust,
            ignition_wire: wires.wire2
        )
        
        

    engine
        .add_cylinder_bank(b0)
        .add_cylinder_bank(b1)

    engine.add_crankshaft(c0)

    vfr750_camshaft_builder camshaft()

    b0.set_cylinder_head (
        vfr750_engine_head(
            intake_camshaft: camshaft.intake_cam_0,
            exhaust_camshaft: camshaft.exhaust_cam_0
        )
    )
    
    b1.set_cylinder_head (
        vfr750_engine_head(
            intake_camshaft: camshaft.intake_cam_1,
            exhaust_camshaft: camshaft.exhaust_cam_1
        )
    )

    engine.add_ignition_module(
        vfr750_distributor(
            wires: wires
        ))
}


label cycle(2 * 360 * units.deg)
private node vfr750_distributor {
    input wires;

    alias output __out:
        ignition_module(timing_curve: timing_curve, rev_limit: 11500 * units.rpm, limiter_duration: 0.055)
            .connect_wire(wires.wire1, (0.0 / 8.0) * cycle)
            .connect_wire(wires.wire2, (5.0 / 8.0) * cycle)
            .connect_wire(wires.wire3, (2.0 / 8.0) * cycle)
            .connect_wire(wires.wire4, (7.0 / 8.0) * cycle);

    function timing_curve(100 * units.rpm)
    timing_curve
        .add_sample(0000 * units.rpm, 10.00 * units.deg)
        .add_sample(0100 * units.rpm, 10.00 * units.deg)
        .add_sample(0200 * units.rpm, 10.00 * units.deg)
        .add_sample(0300 * units.rpm, 10.00 * units.deg)
        .add_sample(0400 * units.rpm, 10.00 * units.deg)
        .add_sample(0500 * units.rpm, 9.00 * units.deg)
        .add_sample(0600 * units.rpm, 7.00 * units.deg)
        .add_sample(0700 * units.rpm, 5.00 * units.deg)
        .add_sample(0800 * units.rpm, 3.00 * units.deg)
        .add_sample(0900 * units.rpm, 1.00 * units.deg)
        .add_sample(1000 * units.rpm, 0.00 * units.deg)
        .add_sample(1100 * units.rpm, 0.47 * units.deg)
        .add_sample(1200 * units.rpm, 0.95 * units.deg)
        .add_sample(1300 * units.rpm, 1.42 * units.deg)
        .add_sample(1400 * units.rpm, 1.90 * units.deg)
        .add_sample(1500 * units.rpm, 2.37 * units.deg)
        .add_sample(1600 * units.rpm, 2.85 * units.deg)
        .add_sample(1700 * units.rpm, 3.32 * units.deg)
        .add_sample(1800 * units.rpm, 3.79 * units.deg)
        .add_sample(1900 * units.rpm, 4.27 * units.deg)
        .add_sample(2000 * units.rpm, 4.74 * units.deg)
        .add_sample(2100 * units.rpm, 5.22 * units.deg)
        .add_sample(2200 * units.rpm, 5.69 * units.deg)
        .add_sample(2300 * units.rpm, 6.17 * units.deg)
        .add_sample(2400 * units.rpm, 6.64 * units.deg)
        .add_sample(2500 * units.rpm, 7.12 * units.deg)
        .add_sample(2600 * units.rpm, 7.59 * units.deg)
        .add_sample(2700 * units.rpm, 8.06 * units.deg)
        .add_sample(2800 * units.rpm, 8.54 * units.deg)
        .add_sample(2900 * units.rpm, 9.01 * units.deg)
        .add_sample(3000 * units.rpm, 9.49 * units.deg)
        .add_sample(3100 * units.rpm, 9.96 * units.deg)
        .add_sample(3200 * units.rpm, 10.44 * units.deg)
        .add_sample(3300 * units.rpm, 10.91 * units.deg)
        .add_sample(3400 * units.rpm, 11.38 * units.deg)
        .add_sample(3500 * units.rpm, 11.86 * units.deg)
        .add_sample(3600 * units.rpm, 12.33 * units.deg)
        .add_sample(3700 * units.rpm, 12.81 * units.deg)
        .add_sample(3800 * units.rpm, 13.28 * units.deg)
        .add_sample(3900 * units.rpm, 13.76 * units.deg)
        .add_sample(4000 * units.rpm, 14.23 * units.deg)
        .add_sample(4100 * units.rpm, 14.71 * units.deg)
        .add_sample(4200 * units.rpm, 15.18 * units.deg)
        .add_sample(4300 * units.rpm, 15.65 * units.deg)
        .add_sample(4400 * units.rpm, 16.13 * units.deg)
        .add_sample(4500 * units.rpm, 16.60 * units.deg)
        .add_sample(4600 * units.rpm, 17.08 * units.deg)
        .add_sample(4700 * units.rpm, 17.55 * units.deg)
        .add_sample(4800 * units.rpm, 18.03 * units.deg)
